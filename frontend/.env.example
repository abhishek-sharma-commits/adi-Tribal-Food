# Leave empty in development: Vite proxies /api to the backend (same-origin keeps cookies simple).
# Set only if the API lives on another origin (then also use COOKIE_SAME_SITE=none on the backend).
VITE_API_BASE_URL=

# Optional hero photograph. Use an image you are licensed to use; none is bundled on purpose.
VITE_HERO_IMAGE_URL=

# Shown on the Contact and Privacy pages. Leave empty and the pages say contact details are not set up yet.
VITE_CONTACT_EMAIL=borangmiyum6@gmail.com
